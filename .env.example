# REST API base URL (either the backend origin or its /api/v1 path; no trailing slash)
NEXT_PUBLIC_API_URL=https://your-api.onrender.com/api/v1
# Cookies blocked after sign-in (frontend and API on different domains)? Use same-origin mode instead:
#   NEXT_PUBLIC_API_URL=/api/v1   and   API_PROXY_TARGET=https://your-api.onrender.com
# then on the backend set FRONTEND_URL to this site, TRUST_PROXY_HOPS=2, COOKIE_SAMESITE=lax, leave COOKIE_DOMAIN empty and use
# https://<this-site>/api/auth/google/callback (and /github/callback) as the OAuth callback URLs.
# API_PROXY_TARGET=
# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# OAuth start URLs are served by the backend: `${API}/auth/oauth/google` and `${API}/auth/oauth/github`.
# Optional toggles (frontend-safe)
NEXT_PUBLIC_ENABLE_GOOGLE=true
NEXT_PUBLIC_ENABLE_GITHUB=true
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# ---- Branding & legal (all optional; defaults are neutral placeholders) ----
NEXT_PUBLIC_BRAND_NAME=CodeWithAws
NEXT_PUBLIC_BRAND_ACCENT=Aws
# Only real numbers! Leave empty to hide. Example: [{"value":"500+","label":"Problems"}]
NEXT_PUBLIC_BRAND_STATS=[]
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER=
NEXT_PUBLIC_JURISDICTION=India
NEXT_PUBLIC_COURTS_CITY=
NEXT_PUBLIC_REFUND_DAYS=7
NEXT_PUBLIC_LEGAL_UPDATED=1 January 2026
